# Discord application credentials
DISCORD_TOKEN=your-bot-token-here
DISCORD_APPLICATION_ID=000000000000000000

# Public URL of your render.com web service (used for slash command registration & health checks)
# Example: https://my-gwent-bot.onrender.com
PUBLIC_BASE_URL=https://your-app.onrender.com

# Database path (relative to project root). On render.com use /var/data/gwent.db
DATABASE_PATH=data/gwent.db

# Guild ID for instant slash-command sync (RECOMMENDED — see note below).
# Leave blank only if you want global commands (slower, ~1 hour propagation,
# and will FAIL if your Discord app has an Embedded App / Activity configured
# — Discord API error 50240).
#
# To get a Guild ID: enable Developer Mode in Discord (User Settings → Advanced),
# right-click your test server → Copy Server ID.
DEV_GUILD_ID=

# Match settings defaults
DEFAULT_MATCH_ROUNDS=3
DEFAULT_MAX_PLAYERS=2

# Logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Port for the HTTP health-check server (render.com expects 10000 by default)
PORT=10000
